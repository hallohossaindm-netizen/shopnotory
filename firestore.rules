rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify administrator privileges
    // In this store, Firebase Authentication is exclusively used for authorized store admins.
    function isAdmin() {
      return isAuthenticated();
    }

    // Default: Deny all writes and reads unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // 0. Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // 1. Products Collection
    // Public can read active products. Only verified admins can create, update, or delete.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. Settings Collection
    // Store settings (announcement, delivery fee, ads banner)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Orders Collection
    // Anyone can create an order with valid data.
    // Reading and updating orders is restricted to verified administrators.
    match /orders/{orderId} {
      allow create: if request.resource.data.customer.name is string
                    && request.resource.data.customer.phone is string
                    && request.resource.data.items is list
                    && request.resource.data.grandTotal is number
                    && request.resource.data.grandTotal >= 0;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Coupons Collection
    // Public can read active coupons to apply in cart. Only admins can modify.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Contacts / Messages Collection
    // Public can submit contact messages. Only admins can read and manage.
    match /contacts/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.message is string;
      allow read, delete: if isAdmin();
    }

    // 6. Analytics Events & Visitor Logs Collection
    // Anyone can log interaction events (page view, product click, session enter)
    // Only verified administrators can read and view analytics data
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }
  }
}
