rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify trusted administrator privileges via custom claims or secure server-provisioned role document
    // Never trust client-supplied roles or hardcoded email strings
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         request.auth.token.role == 'admin' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Default: Deny all writes and reads unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    // 0. Admins Collection
    // Only authenticated admins can read admin profiles; non-admins cannot read or write
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Server-provisioned only via Admin SDK
    }

    // 1. Products Collection
    // Public can read active products. Only verified admins can create, update, or delete.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. Settings Collection
    // Store settings (announcement, delivery fee, ads banner)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Orders Collection
    // Anyone can create an order with valid data.
    // Reading and updating orders is restricted to verified administrators.
    match /orders/{orderId} {
      allow create: if request.resource.data.customer.name is string
                    && request.resource.data.customer.phone is string
                    && request.resource.data.items is list
                    && request.resource.data.grandTotal is number
                    && request.resource.data.grandTotal >= 0;
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Coupons Collection
    // Public can read active coupons to apply in cart. Only admins can modify.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Contacts / Messages Collection
    // Public can submit contact messages. Only admins can read and manage.
    match /contacts/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.message is string;
      allow read, delete: if isAdmin();
    }
  }
}
